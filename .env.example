# Copy this file to .env.local and fill in the values.
# .env.local is never uploaded to GitHub. Never put real keys in this example file.

# Supabase > Project Settings > API Keys / Data API
# The project URL looks like https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (starts with sb_publishable_). Safe to use in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (starts with sb_secret_). Server only: full access, keep private.
SUPABASE_SECRET_KEY=
